{
  "name": "autobucket",
  "version": "1.3.1",
  "description": "Thunderbird auto classification web extension",
  "author": "A-tak <hoge+git@a-tak.com>",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "check:release": "node scripts/check-release.cjs",
    "build": "vite build && npm run build-third-party-notices",
    "build:dev": "vite build --mode development && npm run build-third-party-notices",
    "build-third-party-notices": "node scripts/build-third-party-notices.cjs",
    "build-zip": "node scripts/build-zip.cjs",
    "build-source-zip": "node scripts/build-source-zip.cjs",
    "build:release": "npm run check:release && npm run typecheck && npm run build && npm run build-zip && npm run check:release -- --check-dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "chart.js": "^4.4.0",
    "i18next": "^23.7.0",
    "p-map": "^4.0.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "simple-statistics": "^7.4.0",
    "tiny-segmenter": "^0.2.0",
    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "archiver": "^5.2.0",
    "cross-env": "^7.0.3",
    "husky": "^4.3.8",
    "prettier": "^2.2.1",
    "pretty-quick": "^3.1.0",
    "thunderbird-web-ext-types": "^1.0.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
